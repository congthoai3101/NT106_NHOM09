# Backend HTTP API
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api

# Public TCP game server
GAME_TCP_BIND_HOST=0.0.0.0
GAME_TCP_HOST=127.0.0.1
GAME_TCP_PORT=6000
GAME_TCP_TLS=false
# Production: set both certificate paths and enable TLS on clients.
# GAME_TLS_KEY_PATH=C:\path\to\privkey.pem
# GAME_TLS_CERT_PATH=C:\path\to\fullchain.pem

# Supabase
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]

# Optional Prisma connection strings
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional JWT and SMTP configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
